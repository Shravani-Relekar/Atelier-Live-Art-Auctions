NODE_ENV=development
SERVER_PORT=4000
CLIENT_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://atelier:atelier@localhost:5432/atelier?schema=public

# Use a long random string in production (e.g. `openssl rand -hex 48`)
JWT_SECRET=change-me-to-a-long-random-secret-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=atelier_token

# Cloudinary (optional for local dev - seeded artworks fall back to remote URLs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=atelier/lots

# Auction behaviour
SOFT_CLOSE_WINDOW_SECONDS=120
SOFT_CLOSE_EXTENSION_SECONDS=120
BUYERS_PREMIUM_PERCENT=20
